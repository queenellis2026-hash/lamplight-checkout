# Sandbox credentials go in environment variables only — never in a file.
# Copy this to .env and fill it in, or export the vars in your shell.
# .env is gitignored.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: override the API base. Default is the PayPal sandbox.
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Caller auth for the mutating endpoints (authorize/deliver/capture/void).
# Demo defaults apply when unset (see app/auth.py) — set real tokens for
# anything beyond a local demo. Never put real tokens in a file.
# LAMPLIGHT_PAYER_TOKEN=
# LAMPLIGHT_AGENT_TOKENS={"auditor-01@lamplight.example":"...","writer-02@lamplight.example":"...","coder-03@lamplight.example":"..."}
